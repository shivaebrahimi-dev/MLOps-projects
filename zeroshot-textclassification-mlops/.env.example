# Copy this file to .env. Never commit .env.
# minioadmin is a default for local development only.

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=zeroshot-learning-output

# Docker images for local MinIO and its console
MINIO_IMAGE=bitnamilegacy/minio:2025.7.23-debian-12-r5
MINIO_CONSOLE_IMAGE=bitnamilegacy/minio-object-browser:2.0.2-debian-12-r4

MODEL_DIR=./models
HF_HOME=./.cache/huggingface
HF_TOKEN=

MODELS_CONFIG=configs/models.yaml
LABELS_CONFIG=configs/labels.yaml

MAX_INPUT_CHARS=10000
APP_VERSION=0.1.0
LOG_LEVEL=INFO
