# Copy this file to .env and change the values. The real .env is gitignored.

# --- MinIO -------------------------------------------------------------------
# Used both as the MinIO server's root credentials and by the trainer / API.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-please
# host:port, without a scheme. Compose overrides this to minio:9000 inside containers.
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
# The spelling "minst" is intentional: it is the bucket name the assignment asks for.
MINIO_BUCKET=fashion-minst-bucket

# --- MLflow ------------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Webhook -----------------------------------------------------------------
# Where the training-complete notification is POSTed. Leave empty to skip it.
WEBHOOK_URL=http://localhost:8080/webhook

# --- Prediction service ------------------------------------------------------
# Leave empty to serve the most recently trained model (model/latest.json).
# Set it to pin a specific run, e.g. model/<run-id>/model.pt
MODEL_OBJECT_KEY=
# Where the Streamlit UI finds the API. Compose overrides this to http://api:8000.
API_URL=http://localhost:8000
