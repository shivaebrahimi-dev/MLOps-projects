# Copy this file to .env and fill in your own values. Never commit .env.
# Values are left empty on purpose; the default used when a value is empty is shown in each comment.

# --- OpenAI (LLM and embeddings) ---
OPENAI_API_KEY=
# default: gpt-4o-mini
OPENAI_MODEL=
# default: text-embedding-3-small
EMBEDDING_MODEL=

# --- Langfuse Cloud (project Settings -> API Keys) ---
# default: true (tracing is skipped automatically when the keys are missing)
LANGFUSE_ENABLED=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# default: https://cloud.langfuse.com (EU); US region: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=

# --- Knowledge base and retrieval ---
# default: .chroma
CHROMA_DIR=
# default: knowledge
COLLECTION_NAME=
# default: 800 characters
CHUNK_SIZE=
# default: 120 characters
CHUNK_OVERLAP=
# default: 4
TOP_K=
# default: 0.30 (cosine similarity below this counts as no evidence)
MIN_RELEVANCE=
# default: 10
MAX_UPLOAD_MB=

# default: INFO
LOG_LEVEL=
